menu "VOX M-01 Gemini Direct"

    config VOX_GEMINI_MODEL
        string "Primary Gemini Live model"
        default "gemini-3.1-flash-live-preview"
        help
            Model used for new conversations. A provisioned override
            (RPC set_model) takes precedence without recompiling.
            gemini-3.8-live accepted setup but never transcribed or answered
            over a raw WebSocket in the 2026-11-24 hardware tests.

    config VOX_GEMINI_FALLBACK_MODEL
        string "Fallback Gemini Live model"
        default "gemini-3.8-live"
        help
            Used after repeated setup failures, or once per boot when the
            active model stays silent while the user speaks.

    config VOX_SILENT_MODEL_VOICED_FRAMES
        int "Voiced 40 ms frames without transcription before swapping model"
        range 25 1000
        default 250
        help
            Watchdog for a model that completes setup but never answers: after
            this many loud uplink frames (default 10 s of speech) with no input
            transcription on the connection, reconnect with the other model.

    config VOX_VOICED_PEAK_THRESHOLD
        int "Uplink frame peak counted as voiced (0..32767)"
        range 100 32767
        default 1036
        help
            1036 is about -30 dBFS; the room noise floor measured about -42 dBFS.

    config VOX_GEMINI_VOICE
        string "Prebuilt voice"
        default "Charon"

    config VOX_GEMINI_LANGUAGE
        string "Speech language (BCP-47)"
        default "es-ES"

    config VOX_WAKE_WORD
        bool "Wake on \"Hola ESP\" (local WakeNet10, wn10_es_holaesp)"
        default y
        help
            Listen locally for "Hola ESP" while the conversation is closed. No
            WebSocket is open and no audio leaves the device while idle. Needs the
            "model" partition with the esp-sr model image; without it VOX keeps
            working with touch only.

    config VOX_IDLE_TIMEOUT_S
        int "Seconds without activity before returning to idle"
        range 10 600
        default 15
        help
            While listening, close the conversation after this time with no local
            voice (uplink frames above VOX_VOICED_PEAK_THRESHOLD), user
            transcription, model audio, turn or tap. Counted from the end of
            VOX's speech.

    config VOX_PREROLL_MS
        int "Audio kept after the wake word while connecting (ms)"
        range 400 4000
        default 2000
        help
            Frames captured between "Hola ESP" and setupComplete are sent first so
            the question spoken right after the wake word is not lost.

    config VOX_SPEAKER_VOLUME
        int "Speaker volume (0-100)"
        range 1 100
        default 70

    config VOX_MIC_GAIN_DB
        int "Microphone gain (dB)"
        range 0 42
        default 24
        help
            30 dB saturated (0 dBFS peaks) with normal speech at 20-30 cm and
            with speaker echo in the first hardware tests.

endmenu
