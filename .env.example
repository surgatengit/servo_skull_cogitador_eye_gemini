# VOX M-01 GEMINI DIRECT — ejemplo de configuración local.
# Copia este archivo a `.env` (ignorado por Git) y rellena tus valores.
# NUNCA subas `.env` ni pegues la clave en el código, sdkconfig o registros.
#
# La clave solo se usa en tu PC para enviarla al dispositivo por USB con
#   python tools/provision_key.py
# El firmware NO contiene la clave: la guarda el propio dispositivo en su NVS.

# Clave de API exclusiva de este dispositivo (Google AI Studio).
# Restríngela a "Generative Language API" y ponle cuota en Google Cloud.
GEMINI_API_KEY=

# Opcional: modelo forzado en el dispositivo. Vacío = predeterminado del firmware.
#   gemini-3.8-live | gemini-3.1-flash-live-preview
GEMINI_MODEL=
